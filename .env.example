# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). NUNCA coloque a service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# WhatsApp de suporte que aparece no site e no painel (só números, com DDD).
# Vazio: usa o número padrão de src/lib/support.ts.
VITE_SUPPORT_WHATSAPP=

# Endereço público do site, sem barra no final (usado na imagem de prévia do link).
# Vazio: usa o domínio de produção da Vercel ou https://fechaproposta.vercel.app.
VITE_SITE_URL=
